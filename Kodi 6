public class CharacterInteraction : MonoBehaviour
{
    public Transform partner; // Ikkinchi qahramon
    public float interactionDistance = 2.0f;

    void Update()
    {
        float dist = Vector3.Distance(transform.position, partner.position);

        if (dist < interactionDistance)
        {
            if (Input.GetKeyDown(KeyCode.E)) // Telefonda bu maxsus tugma bo'ladi
            {
                StartDialogue();
            }
        }
    }

    void StartDialogue()
    {
        // Muloqot yoki animatsiya kodi
        Debug.Log("Muloqot boshlandi...");
    }
}
